---
import ArrowLeft from "@lucide/astro/icons/arrow-left";
import ArrowRight from "@lucide/astro/icons/arrow-right";
import { render } from "astro:content";
import ArticleToc from "../components/ArticleToc.astro";
import PlatformLinks from "../components/PlatformLinks.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteLink from "../components/SiteLink.astro";
import { copy, identityProfileLinks } from "../copy";
import {
  formatBlogDate,
  getBlogPosts,
  getTranslationKey,
  getPostPath,
  getReadingStats,
  hasMeaningfulUpdate,
  type BlogLanguage,
  toIsoDate,
  type BlogPost,
} from "../lib/blog";
import "../styles/blog.css";
import Layout from "./Layout.astro";

interface Props {
  post: BlogPost;
  newerPost?: BlogPost;
  olderPost?: BlogPost;
}

const { post, newerPost, olderPost } = Astro.props;
const { Content, headings } = await render(post);
const { data } = post;
const language: BlogLanguage = data.lang;
const isUkrainian = language === "uk";
const allPosts = await getBlogPosts({ includeTranslations: true });
const alternatePost = allPosts.find(
  (candidate) =>
    candidate.id !== post.id &&
    candidate.data.lang !== language &&
    getTranslationKey(candidate) === getTranslationKey(post),
);
const stats = getReadingStats(post.body, data.originalReadingMinutes);
const path = getPostPath(post);
const alternatePath = alternatePost ? getPostPath(alternatePost) : undefined;
const canonicalUrl = new URL(path, "https://andriishupta.dev").toString();
const ogImage = data.ogImage ?? "/blog/og.png";
const dateModified = data.updatedAt ?? data.publishedAt;
const isLegacyBlogUrl = (href: string | undefined) =>
  href ? new URL(href).hostname === "blog.andriishupta.dev" : false;
const directHashnodeUrl =
  data.distribution.hashnode && !isLegacyBlogUrl(data.distribution.hashnode)
    ? data.distribution.hashnode
    : undefined;
const distributionLinks = copy.mainPage.blog.platformLinks
  .map((platform) => ({
    ...platform,
    href: data.distribution[platform.id],
  }))
  .filter(
    (
      item,
    ): item is (typeof copy.mainPage.blog.platformLinks)[number] & {
      href: string;
    } => Boolean(item.href) && !isLegacyBlogUrl(item.href),
  );
const articleStructuredData = {
  "@type": "BlogPosting",
  "@id": `${canonicalUrl}#article`,
  headline: data.title,
  description: data.description,
  datePublished: toIsoDate(data.publishedAt),
  dateModified: toIsoDate(dateModified),
  inLanguage: isUkrainian ? "uk-UA" : "en-US",
  mainEntityOfPage: canonicalUrl,
  image: new URL(ogImage, canonicalUrl).toString(),
  author: {
    "@type": "Person",
    "@id": "https://andriishupta.dev/#person",
    name: copy.identity.fullName,
    url: "https://andriishupta.dev",
    sameAs: identityProfileLinks.map(({ href }) => href),
  },
  isPartOf: {
    "@type": "Blog",
    "@id": "https://andriishupta.dev/blog/#blog",
    name: `${copy.identity.fullName} — Blog`,
  },
  keywords: data.tags.join(", "),
  ...(stats.wordCount > 0
    ? {
        wordCount: stats.wordCount,
        timeRequired: `PT${stats.readingMinutes}M`,
      }
    : {}),
};
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [articleStructuredData],
};
const labels = isUkrainian
  ? {
      back: "Назад до блогу",
      published: "Опубліковано",
      updated: "Оновлено",
      readingTime: "Час читання",
      originalReadingTime: "Початковий час читання",
      words: "Слів",
      distribution: "Також опубліковано на",
      tags: "Теги статті",
      moreArticles: "Інші статті",
      newer: "Новіша стаття",
      older: "Старіша стаття",
      backToAll: "Назад до всіх статей",
      language: "Мова статті",
      availableLanguages: "Available in languages",
      alternateNotice: "You can read this article in English:",
      english: "English",
      ukrainian: "Українська",
    }
  : {
      back: "Back to blog",
      published: "Published",
      updated: "Updated",
      readingTime: "Reading time",
      originalReadingTime: "Original read",
      words: "Words",
      distribution: "Also published on",
      tags: "Article tags",
      moreArticles: "More articles",
      newer: "Newer article",
      older: "Older article",
      backToAll: "Back to all articles",
      language: "Article language",
      availableLanguages: "Available in languages",
      alternateNotice: "You can read this article in Ukrainian:",
      english: "English",
      ukrainian: "Українська",
    };
---

<Layout
  title={`${data.title} | ${copy.identity.fullName}`}
  description={data.description}
  pathname={path}
  image={ogImage}
  imageAlt={`${data.title} — ${copy.identity.fullName}`}
  ogType="article"
  structuredData={structuredData}
  robots={stats.isStub ? "noindex, follow" : undefined}
  showThemeSwitcher={false}
  rss
  publishedTime={data.publishedAt.toISOString()}
  modifiedTime={dateModified.toISOString()}
  tags={data.tags}
  lang={language}
  alternateLanguages={
    alternatePost
      ? [{ lang: alternatePost.data.lang, href: alternatePath ?? path }]
      : []
  }
>
  <SiteHeader context="blog" />

  <main>
    <header class="article-hero">
      <a class="article-back" href="/blog">
        <ArrowLeft aria-hidden="true" />
        <span>{labels.back}</span>
      </a>
      <h1 class="heading-display">{data.title}</h1>
      {data.subtitle && <p class="article-hero__subtitle">{data.subtitle}</p>}
    </header>

    <div class="article-page">
      <div class="article-meta">
        <div class="article-meta__main">
          <dl>
            <div>
                <dt>{labels.published}</dt>
                <dd>
                  <time datetime={toIsoDate(data.publishedAt)}>
                  {formatBlogDate(data.publishedAt, language)}
                </time>
              </dd>
            </div>
            {
              hasMeaningfulUpdate(post) && data.updatedAt && (
                <div>
                  <dt>{labels.updated}</dt>
                  <dd>
                    <time datetime={toIsoDate(data.updatedAt)}>
                      {formatBlogDate(data.updatedAt, language)}
                    </time>
                  </dd>
                </div>
              )
            }
            {
              stats.readingMinutes > 0 && (
                <div>
                  <dt>
                    {stats.isStub
                      ? labels.originalReadingTime
                      : labels.readingTime}
                  </dt>
                  <dd>{stats.readingMinutes} min</dd>
                </div>
              )
            }
            {
              stats.wordCount > 0 && (
                <div>
                  <dt>{labels.words}</dt>
                  <dd>{stats.wordCount.toLocaleString("en")}</dd>
                </div>
              )
            }
          </dl>
        </div>

        <div class="article-meta__aside">
          {
            alternatePost && alternatePath && (
              <div class="article-language">
                <span class="article-language__label">
                  {labels.availableLanguages}
                </span>
                <nav aria-label={labels.language}>
                  <span class="article-language__current" aria-current="page">
                    {isUkrainian ? labels.ukrainian : labels.english}
                  </span>
                  <a
                    href={alternatePath}
                    lang={alternatePost.data.lang}
                    hreflang={alternatePost.data.lang}
                  >
                    {isUkrainian ? labels.english : labels.ukrainian}
                  </a>
                </nav>
                <p class="article-language__notice">
                  {labels.alternateNotice}{" "}
                  <a
                    href={alternatePath}
                    lang={alternatePost.data.lang}
                    hreflang={alternatePost.data.lang}
                  >
                    {isUkrainian ? labels.english : labels.ukrainian}
                  </a>
                </p>
              </div>
            )
          }
          {
            distributionLinks.length > 0 && (
              <div class="article-distribution" aria-label={labels.distribution}>
                <PlatformLinks
                  links={distributionLinks}
                  ariaLabel={labels.distribution}
                  rel="syndication"
                />
              </div>
            )
          }

          <ul class="article-meta__tags" aria-label={labels.tags}>
            {data.tags.map((tag) => <li>#{tag}</li>)}
          </ul>
        </div>
      </div>

      <ArticleToc headings={headings} mobile lang={language} />

    {
      data.cover && (
        <figure class="article-cover">
          <img
            src={data.cover}
            alt={data.coverAlt ?? ""}
            width="1200"
            height="630"
            loading="eager"
            fetchpriority="high"
          />
        </figure>
      )
    }

    <div
      class:list={[
        "article-grid",
        { "article-grid--no-toc": headings.length === 0 },
      ]}
    >
      <ArticleToc headings={headings} lang={language} />
      <article class="article-content" data-article-content>
        {
          stats.isStub ? (
            <div class="article-import-note">
              <h2>Article import in progress</h2>
              <p>
                The permanent URL and original metadata are in place. The article body
                is still being moved from the previous publication.
              </p>
              {directHashnodeUrl && (
                <SiteLink
                  href={directHashnodeUrl}
                >
                  Read the original on Hashnode
                </SiteLink>
              )}
            </div>
          ) : (
            <Content />
          )
        }
      </article>
    </div>

    <footer class="article-end">
      <nav class="article-neighbors" aria-label={labels.moreArticles}>
        {
          newerPost ? (
            <a href={getPostPath(newerPost)}>
              <ArrowLeft aria-hidden="true" />
              <span>
                    <small>{labels.newer}</small>
                <strong>{newerPost.data.title}</strong>
              </span>
            </a>
          ) : (
            <span />
          )
        }
        {
          olderPost && (
            <a href={getPostPath(olderPost)}>
              <span>
                <small>{labels.older}</small>
                <strong>{olderPost.data.title}</strong>
              </span>
              <ArrowRight aria-hidden="true" />
            </a>
          )
        }
      </nav>

      <a class="article-end__back" href="/blog">
        <ArrowLeft aria-hidden="true" />
        <span>{labels.backToAll}</span>
      </a>
    </footer>
    </div>
  </main>

  <SiteFooter />
</Layout>

<script>
  const article = document.querySelector<HTMLElement>("[data-article-content]");

  article?.querySelectorAll("pre").forEach((pre) => {
    const code = pre.querySelector("code");
    if (!code || pre.querySelector("[data-copy-code]")) return;

    const button = document.createElement("button");
    button.type = "button";
    button.className = "code-copy";
    button.dataset.copyCode = "";
    button.textContent = "Copy";
    button.setAttribute("aria-label", "Copy code block");
    button.addEventListener("click", async () => {
      await navigator.clipboard.writeText(code.textContent ?? "");
      button.textContent = "Copied";
      window.setTimeout(() => {
        button.textContent = "Copy";
      }, 1600);
    });
    pre.append(button);
  });

  const tocLinks = Array.from(
    document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]"),
  );
  const headingIds = [...new Set(tocLinks.map((link) => link.dataset.tocLink))];
  const headings = headingIds
    .map((id) => (id ? document.getElementById(id) : null))
    .filter((heading): heading is HTMLElement => Boolean(heading));

  if (headings.length > 0 && "IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        const active = entries.find((entry) => entry.isIntersecting);
        if (!active) return;

        tocLinks.forEach((link) => {
          if (link.dataset.tocLink === active.target.id) {
            link.setAttribute("aria-current", "location");
          } else {
            link.removeAttribute("aria-current");
          }
        });
      },
      { rootMargin: "-16% 0px -68%", threshold: 0 },
    );
    headings.forEach((heading) => observer.observe(heading));
  }
</script>

---
import type { LinkBrand, LinkIconName } from "../lib/links";
import LinkIcon from "./LinkIcon.astro";
import SiteLink from "./SiteLink.astro";

interface Props {
  link: {
    label: string;
    href: string;
    brand?: LinkBrand;
    icon?: LinkIconName;
  };
  compact?: boolean;
  showLabel?: boolean;
}

const { link, compact = false, showLabel = true } = Astro.props;
const iconOnly = !showLabel;
const className = ["social-link", compact && "social-link--compact"]
  .filter(Boolean)
  .join(" ");
---

<SiteLink
  class={className}
  href={link.href}
  ariaLabel={iconOnly ? link.label : undefined}
  title={iconOnly ? link.label : undefined}
>
  <LinkIcon brand={link.brand} icon={link.icon} class="social-link__icon" />
  {showLabel && <span>{link.label}</span>}
</SiteLink>

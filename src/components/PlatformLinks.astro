---
import BrandIcon from "./BrandIcon.astro";
import SiteLink from "./SiteLink.astro";

export type PlatformLink = {
  label: string;
  href: string;
  brand: "devto" | "medium" | "hashnode";
};

interface Props {
  links: PlatformLink[];
  class?: string;
  ariaLabel?: string;
  rel?: string;
}

const {
  links,
  class: className,
  ariaLabel = "Writing platforms",
  rel,
} = Astro.props;
---

{
  links.length > 0 && (
    <nav class:list={["platform-links", className]} aria-label={ariaLabel}>
      {links.map((link) => (
        <SiteLink
          href={link.href}
          rel={rel}
          indicator="corner"
          ariaLabel={link.label}
          title={link.label}
        >
          <BrandIcon name={link.brand} />
          {link.brand !== "hashnode" && <span>{link.label}</span>}
        </SiteLink>
      ))}
    </nav>
  )
}

---
import ArrowUpRight from "@lucide/astro/icons/arrow-up-right";
import BrandIcon from "./BrandIcon.astro";

export type PlatformLink = {
  label: string;
  href: string;
  brand: "devto" | "medium" | "hashnode";
};

interface Props {
  links: PlatformLink[];
  class?: string;
  ariaLabel?: string;
  rel?: string;
}

const {
  links,
  class: className,
  ariaLabel = "Writing platforms",
  rel = "noopener noreferrer",
} = Astro.props;
---

{
  links.length > 0 && (
    <nav class:list={["platform-links", className]} aria-label={ariaLabel}>
      {links.map((link) => (
        <a
          href={link.href}
          target="_blank"
          rel={rel}
          aria-label={link.label}
          title={link.label}
        >
          <BrandIcon name={link.brand} />
          {link.brand !== "hashnode" && <span>{link.label}</span>}
          <ArrowUpRight class="platform-links__out" aria-hidden="true" />
        </a>
      ))}
    </nav>
  )
}

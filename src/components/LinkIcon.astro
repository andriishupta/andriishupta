---
import BriefcaseBusiness from "@lucide/astro/icons/briefcase-business";
import FileUser from "@lucide/astro/icons/file-user";
import Mail from "@lucide/astro/icons/mail";
import PenLine from "@lucide/astro/icons/pen-line";
import type { LinkBrand, LinkIconName } from "../lib/links";
import BrandIcon from "./BrandIcon.astro";

interface Props {
  brand?: LinkBrand;
  icon?: LinkIconName;
  class?: string;
}

const { brand, icon, class: className } = Astro.props;
const icons = {
  upwork: BriefcaseBusiness,
  cv: FileUser,
  blog: PenLine,
  email: Mail,
} as const;
const Icon = icon ? icons[icon] : undefined;
---

{brand && <BrandIcon name={brand} class={className} />}
{Icon && <Icon class={className} aria-hidden="true" />}

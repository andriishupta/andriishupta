---
import ArrowUpRight from "@lucide/astro/icons/arrow-up-right";
import { copy } from "../copy";
import FeedbackMessage from "./FeedbackMessage.astro";
import LinkIcon from "./LinkIcon.astro";
import SectionHeading from "./SectionHeading.astro";
import SiteLink from "./SiteLink.astro";

interface Props {
  kind: "clients" | "teammates";
}

const { proof } = copy.mainPage;
const { kind } = Astro.props;
const isClients = kind === "clients";
const sectionId = isClients ? "proof" : "teammates";
const titleId = `${sectionId}-title`;
---

<section
  class:list={["consulting-proof", `consulting-proof--${kind}`]}
  id={sectionId}
  data-proof-kind={kind}
  aria-labelledby={titleId}
>
  <div class="consulting-proof__inner site-container">
    <SectionHeading
      id={titleId}
      heading={isClients ? proof.clientsHeading : proof.teammatesHeading}
      description={isClients ? proof.clientsDescription : proof.teammatesDescription}
    />

    {
      isClients ? (
        <div class="proof-platform proof-platform--upwork">
          <header class="proof-platform__heading">
            <div>
              <h3><LinkIcon icon="upwork" /> Client feedback</h3>
              <p>Selected feedback from real engagements.</p>
            </div>
            <SiteLink
              href={proof.upworkHref}
              indicator="none"
              ariaLabel="View Upwork profile"
            >
              View Upwork profile
              <ArrowUpRight aria-hidden="true" />
            </SiteLink>
          </header>

          <div class="proof-message-grid proof-message-grid--upwork">
            {proof.upwork.map((message) => (
              <FeedbackMessage
                {...message}
                source="Upwork · Client feedback"
              />
            ))}
          </div>
        </div>
      ) : (
        <div class="proof-platform proof-platform--linkedin">
          <header class="proof-platform__heading">
            <div>
              <h3><LinkIcon brand="linkedin" /> Teammate recommendations</h3>
              <p>Short recommendations from people I worked with directly.</p>
            </div>
            <SiteLink
              href={proof.linkedinHref}
              indicator="none"
              ariaLabel="View LinkedIn profile"
            >
              View LinkedIn profile
              <ArrowUpRight aria-hidden="true" />
            </SiteLink>
          </header>

          <div class="proof-message-grid proof-message-grid--linkedin">
            {proof.linkedin.map((message) => (
              <FeedbackMessage
                {...message}
                source="LinkedIn · Teammate recommendation"
              />
            ))}
          </div>
        </div>
      )
    }
  </div>
</section>

<script>
  import { revealOnScroll } from "../lib/motion";

  document.querySelectorAll<HTMLElement>("[data-proof-kind]").forEach((section) => {
    const isClientProof = section.dataset.proofKind === "clients";
    revealOnScroll(section, {
      selector: ".proof-message",
      x: isClientProof ? -12 : 0,
      y: isClientProof ? 16 : 12,
      stagger: 0.08,
    });
  });
</script>

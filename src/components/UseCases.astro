---
import ArrowUpRight from "@lucide/astro/icons/arrow-up-right";
import { copy } from "../copy";
import SectionHeading from "./SectionHeading.astro";
import SiteLink from "./SiteLink.astro";

const { useCases } = copy.mainPage;
---

<section
  class="consulting-use-cases"
  id="work"
  data-reveal-group
  aria-labelledby="work-title"
>
  <div class="consulting-use-cases__inner site-container">
    <SectionHeading
      id="work-title"
      heading={useCases.heading}
      description={useCases.description}
    />

    <div class="use-case-list">
      {useCases.items.map((item, index) => (
        <article
          class="use-case-block"
          data-reveal-item
          style={`--reveal-order: ${index}`}
        >
          <div class="use-case-block__top">
            <span class="use-case-block__client">{item.client}</span>
            <span>{item.context}</span>
          </div>
          <h3>{item.title}</h3>
          <p>{item.description}</p>
          <SiteLink class="text-link" href="/blog?topic=consulting" external={false}>
            Related notes
            <ArrowUpRight aria-hidden="true" />
          </SiteLink>
        </article>
      ))}
    </div>
  </div>
</section>

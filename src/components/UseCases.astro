---
import ArrowUpRight from "@lucide/astro/icons/arrow-up-right";
import { copy } from "../copy";
import SiteLink from "./SiteLink.astro";

const { useCases } = copy.mainPage;
---

<section class="consulting-use-cases" id="work" aria-labelledby="work-title">
  <div class="consulting-use-cases__inner site-container">
    <header class="section-heading">
      <h2 class="heading-display" id="work-title">{useCases.heading}</h2>
      <p>{useCases.description}</p>
    </header>

    <div class="use-case-list">
      {useCases.items.map((item) => (
        <article class="use-case-row">
          <div class="use-case-row__meta">
            <span>{item.client}</span>
            <span>{item.context}</span>
          </div>
          <div class="use-case-row__body">
            <h3>{item.title}</h3>
            <p>{item.description}</p>
            <SiteLink class="text-link" href="/blog?topic=api-development" external={false}>
              Related notes
              <ArrowUpRight aria-hidden="true" />
            </SiteLink>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

---

{
  imageSrc ? (
    <img
      class:list={[className, { "brand-icon--hashnode": name === "hashnode" }]}
      src={imageSrc}
      alt=""
      aria-hidden="true"
    />
  ) : (
    <svg
      class={className}
      viewBox={icon?.viewBox}
      fill="currentColor"
      aria-hidden="true"
      focusable="false"
    >
      <path d={icon?.path}></path>
    </svg>
  )
}

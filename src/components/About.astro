---
import ArrowRight from "@lucide/astro/icons/arrow-right";
import { copy } from "../copy";

const { about } = copy.mainPage;
---

<section class="consulting-services" id="services" aria-labelledby="services-title">
  <div class="consulting-services__inner site-container">
    <header class="section-heading">
      <h2 class="heading-display" id="services-title">{about.heading}</h2>
      <p>{about.description}</p>
    </header>

    <div class="service-list">
      {about.services.map((service) => (
        <article class="service-row">
          <div class="service-row__title">
            <h3>{service.title}</h3>
            <ArrowRight aria-hidden="true" />
          </div>
          <p>{service.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>

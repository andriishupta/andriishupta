---
import ArrowUpRight from "@lucide/astro/icons/arrow-up-right";
import { copy } from "../copy";
import SectionHeading from "./SectionHeading.astro";

const { about } = copy.mainPage;
---

<section class="consulting-services" id="services" data-services aria-labelledby="services-title">
  <div class="consulting-services__inner site-container">
    <SectionHeading
      id="services-title"
      heading={about.heading}
      description={about.description}
    />

    <div class="service-list">
      {about.services.map((service) => (
        <article class="service-block">
          <header class="service-block__title">
            <h3>{service.title}</h3>
          </header>
          <div class="service-block__body">
            <p>{service.description}</p>
            <a class="text-link" href="#work">
              See related work
              <ArrowUpRight aria-hidden="true" />
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  import { revealOnScroll } from "../lib/motion";

  document.querySelectorAll<HTMLElement>("[data-services]").forEach((section) => {
    revealOnScroll(section, {
      selector: ".service-block",
      x: -20,
      y: 0,
      stagger: 0.08,
    });
  });
</script>

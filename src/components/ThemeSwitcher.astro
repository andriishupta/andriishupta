---
import Monitor from "@lucide/astro/icons/monitor";
import Moon from "@lucide/astro/icons/moon";
import Sun from "@lucide/astro/icons/sun";

interface Props {
  embedded?: boolean;
}

const { embedded = false } = Astro.props;

const options = [
  {
    mode: "device",
    label: "System",
    ariaLabel: "Use device theme",
    Icon: Monitor,
  },
  { mode: "light", label: "Light", ariaLabel: "Use light theme", Icon: Sun },
  { mode: "dark", label: "Dark", ariaLabel: "Use dark theme", Icon: Moon },
] as const;
---

<div
  class:list={["site-controls", { "site-controls--embedded": embedded }]}
  aria-label="Appearance settings"
>
  <details class="theme-switcher" data-theme-switcher>
    <summary
      class="theme-switcher__trigger"
      aria-label="Theme: System. Choose theme"
      title="Theme: System"
    >
      {
        options.map(({ mode, Icon }) => (
          <Icon
            class="theme-switcher__current-icon"
            data-theme-icon={mode}
            aria-hidden="true"
          />
        ))
      }
      <span class="sr-only" data-theme-current-label>System</span>
    </summary>

    <div class="theme-switcher__menu" role="group" aria-label="Choose color theme">
      {
        options.map(({ mode, label, ariaLabel, Icon }) => (
        <button
          class="theme-switcher__option"
          type="button"
          data-theme-option={mode}
          data-theme-label={label}
          aria-label={ariaLabel}
          aria-pressed={mode === "device" ? "true" : "false"}
        >
          <Icon aria-hidden="true" />
          <span>{label}</span>
        </button>
      ))
    }
    </div>
  </details>
</div>

<script>
  type ThemeMode = "device" | "light" | "dark";

  const storageKey = "andrii-theme";
  const root = document.documentElement;
  const systemDark = window.matchMedia("(prefers-color-scheme: dark)");
  const themeColor = document.querySelector<HTMLMetaElement>("[data-theme-color]");
  const switcher = document.querySelector<HTMLDetailsElement>("[data-theme-switcher]");
  const trigger = switcher?.querySelector<HTMLElement>("summary");
  const currentLabel = switcher?.querySelector<HTMLElement>("[data-theme-current-label]");
  const buttons = Array.from(
    document.querySelectorAll<HTMLButtonElement>("[data-theme-option]"),
  );
  let transitionTimer: number | undefined;

  const isThemeMode = (value: string | undefined): value is ThemeMode =>
    value === "device" || value === "light" || value === "dark";

  const resolvedTheme = (mode: ThemeMode) =>
    mode === "dark" || (mode === "device" && systemDark.matches)
      ? "dark"
      : "light";

  const syncTheme = (mode: ThemeMode, persist = false, animate = false) => {
    const resolved = resolvedTheme(mode);
    root.dataset.theme = mode;
    root.style.colorScheme = resolved;
    const resolvedColor = themeColor?.getAttribute(
      resolved === "dark" ? "data-theme-color-dark" : "data-theme-color-light",
    );
    if (resolvedColor) themeColor?.setAttribute("content", resolvedColor);

    buttons.forEach((button) => {
      button.setAttribute(
        "aria-pressed",
        String(button.dataset.themeOption === mode),
      );
    });

    const selectedButton = buttons.find(
      (button) => button.dataset.themeOption === mode,
    );
    const label = selectedButton?.dataset.themeLabel ?? "System";
    if (currentLabel) currentLabel.textContent = label;
    trigger?.setAttribute("aria-label", `Theme: ${label}. Choose theme`);
    trigger?.setAttribute("title", `Theme: ${label}`);

    if (persist) {
      try {
        window.localStorage.setItem(storageKey, mode);
      } catch {
        // Theme selection still works when storage is unavailable.
      }
    }

    if (animate) {
      root.dataset.themeTransitioning = "true";
      window.clearTimeout(transitionTimer);
      transitionTimer = window.setTimeout(() => {
        delete root.dataset.themeTransitioning;
      }, 360);
    }
  };

  buttons.forEach((button) => {
    button.addEventListener("click", () => {
      const mode = button.dataset.themeOption;
      if (!isThemeMode(mode)) return;

      if (trigger) trigger.dataset.animating = "true";
      window.setTimeout(() => {
        if (trigger) delete trigger.dataset.animating;
      }, 360);
      syncTheme(mode, true, true);
      switcher?.removeAttribute("open");
    });
  });

  document.addEventListener("pointerdown", (event) => {
    if (!switcher?.open || !(event.target instanceof Node)) return;
    if (!switcher.contains(event.target)) switcher.removeAttribute("open");
  });

  systemDark.addEventListener("change", () => {
    if (root.dataset.theme === "device") syncTheme("device");
  });

  const initialMode = isThemeMode(root.dataset.theme)
    ? root.dataset.theme
    : "device";
  syncTheme(initialMode);
</script>

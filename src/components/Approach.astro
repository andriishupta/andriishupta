---
import { copy } from "../copy";
import SectionHeading from "./SectionHeading.astro";

const { approach } = copy.mainPage;
---

<section
  class="consulting-approach"
  id="approach"
  data-reveal-group
  aria-labelledby="approach-title"
>
  <div class="consulting-approach__inner site-container">
    <SectionHeading
      id="approach-title"
      heading={approach.heading}
      description={approach.description}
    />

    <ol class="approach-timeline">
      {approach.steps.map((step, index) => (
        <li
          class="approach-step"
          data-reveal-item
          style={`--reveal-order: ${index}`}
        >
          <span class="approach-step__index">{step.index}</span>
          <div class="approach-step__content">
            <h3>{step.title}</h3>
            <p>{step.description}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

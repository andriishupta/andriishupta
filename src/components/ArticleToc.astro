---
import type { MarkdownHeading } from "astro";
import type { BlogLanguage } from "../lib/blog";

interface Props {
  headings: MarkdownHeading[];
  mobile?: boolean;
  lang?: BlogLanguage;
}

const { headings, mobile = false, lang = "en" } = Astro.props;
const visibleHeadings = headings.filter(
  ({ depth }) => depth === 2 || depth === 3,
);
const label = lang === "uk" ? "На цій сторінці" : "On this page";
---

{
  visibleHeadings.length > 0 &&
    (mobile ? (
      <details class="article-toc article-toc--mobile">
        <summary>{label}</summary>
        <ol>
          {visibleHeadings.map((heading) => (
            <li class:list={{ "article-toc__nested": heading.depth === 3 }}>
              <a href={`#${heading.slug}`} data-toc-link={heading.slug}>
                {heading.text}
              </a>
            </li>
          ))}
        </ol>
      </details>
    ) : (
      <aside class="article-toc article-toc--desktop" aria-label={label}>
        <p>{label}</p>
        <ol>
          {visibleHeadings.map((heading) => (
            <li class:list={{ "article-toc__nested": heading.depth === 3 }}>
              <a href={`#${heading.slug}`} data-toc-link={heading.slug}>
                {heading.text}
              </a>
            </li>
          ))}
        </ol>
      </aside>
    ))
}

---
import ArrowUpRight from "@lucide/astro/icons/arrow-up-right";
import { copy, urls } from "../copy";
import SiteLink from "./SiteLink.astro";
import ThemeSwitcher from "./ThemeSwitcher.astro";

const { intro } = copy.mainPage;
---

<section class="consulting-hero" data-hero aria-labelledby="hero-title">
  <header class="home-nav site-container" data-hero-identity>
    <nav class="home-nav__primary" aria-label="Primary navigation">
      <a class="home-nav__optional" href="#services">Services</a>
      <a class="home-nav__optional" href="#approach">Approach</a>
      <a href="#work">Work</a>
      <a href="/blog">Notes</a>
    </nav>

    <SiteLink
      class="home-nav__cta"
      href={urls.email}
      external={false}
      ariaLabel="Write to me"
      title="Write to me"
    >
      <span>Write to me</span>
      <ArrowUpRight aria-hidden="true" />
    </SiteLink>

    <ThemeSwitcher embedded />
  </header>

  <div class="consulting-hero__body site-container">
    <div class="consulting-hero__identity" data-hero-copy>
      <h1 class="consulting-hero__title heading-display" id="hero-title">
        {intro.heading}
      </h1>
      <p class="consulting-hero__statement">{intro.description}</p>
      <div class="consulting-hero__actions">
        <SiteLink class="button button--solid" href={urls.email} external={false}>
          Write to me
          <ArrowUpRight aria-hidden="true" />
        </SiteLink>
        <a class="text-link" href="#services">See how I can help</a>
      </div>

      <div class="consulting-hero__focus" data-hero-links>
        <p>{intro.aside}</p>
        <ul aria-label="Consulting focus">
          {intro.focus.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";

  const runHeroIntro = () => {
    const hero = document.querySelector<HTMLElement>("[data-hero]");
    if (!hero || hero.dataset.introReady === "true") return;
    hero.dataset.introReady = "true";

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      hero.dataset.introComplete = "true";
      return;
    }

    const timeline = gsap.timeline({
      defaults: { ease: "power4.out" },
      onComplete: () => {
        hero.dataset.introComplete = "true";
      },
    });
    timeline
      .fromTo(
        hero.querySelector("[data-hero-identity]"),
        { opacity: 0, y: 18 },
        { opacity: 1, y: 0, duration: 0.6 },
      )
      .fromTo(
        hero.querySelector("[data-hero-copy]"),
        { opacity: 0, y: 22 },
        { opacity: 1, y: 0, duration: 0.72 },
        "-=0.34",
      )
      .fromTo(
        hero.querySelector("[data-hero-links]"),
        { opacity: 0, y: 18 },
        { opacity: 1, y: 0, duration: 0.62 },
        "-=0.44",
      );
  };

  runHeroIntro();
</script>

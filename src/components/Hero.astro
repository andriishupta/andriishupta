---
import Mail from "@lucide/astro/icons/mail";
import Triangle from "@lucide/astro/icons/triangle";
import { copy, urls } from "../copy";
import SiteHeader from "./SiteHeader.astro";
import SiteLink from "./SiteLink.astro";

const { intro } = copy.mainPage;
---

<section class="consulting-hero" data-hero aria-labelledby="hero-title">
  <SiteHeader animated />

  <div class="consulting-hero__body site-container">
    <div class="consulting-hero__identity" data-hero-copy>
      <h1 class="consulting-hero__title heading-display" id="hero-title">
        {copy.seo.title}
      </h1>
      <p class="consulting-hero__subtitle">Build the product. Clarify the system.</p>
      <p class="consulting-hero__statement">{intro.description}</p>
      <div class="consulting-hero__actions">
        <SiteLink class="button button--solid" href={urls.email} external={false}>
          Write to me
          <Mail aria-hidden="true" />
        </SiteLink>
        <a class="text-link" href="#services">See how I can help</a>
      </div>

    </div>

    <aside class="consulting-hero__rail" data-hero-links aria-label="How Andrii can help">
      <div class="hero-rail__intro">
        <h2>Bring me in when a product needs a clearer technical path.</h2>
      </div>
      <ul>
        {intro.focus.map((item, index) => (
          <li>
            <Triangle
              class="hero-rail__marker"
              data-hero-marker
              style={`--marker-angle: ${index * 90}deg`}
              aria-hidden="true"
            />
            <span>{item}</span>
          </li>
        ))}
      </ul>
      <p>{intro.aside}</p>
    </aside>
  </div>
</section>

<script>
  import { gsap } from "gsap";

  const runHeroIntro = () => {
    const hero = document.querySelector<HTMLElement>("[data-hero]");
    if (!hero || hero.dataset.introReady === "true") return;
    hero.dataset.introReady = "true";

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      hero.dataset.introComplete = "true";
      return;
    }

    const timeline = gsap.timeline({
      defaults: { ease: "power4.out" },
      onComplete: () => {
        hero.dataset.introComplete = "true";
      },
    });
    timeline
      .fromTo(
        hero.querySelector("[data-hero-identity]"),
        { opacity: 0, y: 18 },
        { opacity: 1, y: 0, duration: 0.6 },
      )
      .fromTo(
        hero.querySelector("[data-hero-copy]"),
        { opacity: 0, y: 22 },
        { opacity: 1, y: 0, duration: 0.72 },
        "-=0.34",
      )
      .fromTo(
        hero.querySelector("[data-hero-links]"),
        { opacity: 0, y: 18 },
        { opacity: 1, y: 0, duration: 0.62 },
        "-=0.44",
      );

    hero.querySelectorAll<SVGElement>("[data-hero-marker]").forEach((marker, index) => {
      gsap.to(marker, {
        rotation: `${index % 2 === 0 ? "+=" : "-="}360`,
        duration: 18 + index * 4,
        ease: "none",
        repeat: -1,
        transformOrigin: "50% 50%",
      });
    });
  };

  runHeroIntro();
</script>

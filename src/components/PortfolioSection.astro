---
import ArrowRight from "@lucide/astro/icons/arrow-right";
import { getPortfolioItems } from "../lib/portfolio";
import { copy } from "../copy";
import SectionHeading from "./SectionHeading.astro";
import PortfolioCard from "./PortfolioCard.astro";
import "../styles/portfolio.css";

const featuredPortfolioItems = (
  await getPortfolioItems({ featuredFirst: true })
).slice(0, 3);
---

<section class="portfolio-section" id="portfolio" data-reveal-group aria-labelledby="portfolio-title">
  <div class="portfolio-section__inner site-container">
    <SectionHeading
      id="portfolio-title"
      heading={copy.pages.portfolio.sectionHeading}
      description={copy.pages.portfolio.sectionDescription}
    />

    <div class="portfolio-grid">
      {featuredPortfolioItems.map((item, index) => (
        <PortfolioCard item={item} revealOrder={index} />
      ))}
    </div>

    <a class="text-link portfolio-section__all" href={copy.pages.portfolio.path}>
      {copy.pages.portfolio.sectionLinkLabel}
      <ArrowRight aria-hidden="true" />
    </a>
  </div>
</section>

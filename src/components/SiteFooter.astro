---
import Mail from "@lucide/astro/icons/mail";
import Rss from "@lucide/astro/icons/rss";
import { copy, urls } from "../copy";
import LinkIcon from "./LinkIcon.astro";
import SiteLink from "./SiteLink.astro";
import SocialProfileLinks from "./SocialProfileLinks.astro";

const year = new Date().getUTCFullYear();
---

<footer class="site-footer">
  <div class="site-footer__inner site-container">
    <div class="site-footer__main">
      <div class="site-footer__links">
        <nav class="site-footer__column" aria-label="About Andrii">
          <h2>About</h2>
          <a href="/#services">Services</a>
          <a href="/#proof">Proof</a>
          <a href="/#approach">Approach</a>
          <SiteLink
            class="site-footer__external-text-link"
            href={urls.cv}
            external
            indicator="corner"
          >
            CV
          </SiteLink>
        </nav>

        <nav class="site-footer__column" aria-label="Work and writing">
          <h2>Work</h2>
          <a href="/#work">Use cases</a>
          <a href="/#experience">Experience</a>
          <a href={urls.blogPath}>
            <span>Blog</span>
            <LinkIcon icon="blog" />
          </a>
          <a href="/blog/rss.xml">
            <span>RSS</span>
            <Rss aria-hidden="true" />
          </a>
        </nav>
      </div>

      <div class="site-footer__column site-footer__column--connect">
        <h2>Connect</h2>
        <SiteLink class="site-footer__email" href={urls.email} external={false}>
          <Mail aria-hidden="true" />
          <span>{copy.identity.email}</span>
        </SiteLink>
        <SocialProfileLinks
          class="site-footer__socials"
          linkClass="site-footer__social-link"
        />
      </div>
    </div>
    <div class="site-footer__legal">© {year} {copy.identity.fullName}</div>
  </div>
</footer>

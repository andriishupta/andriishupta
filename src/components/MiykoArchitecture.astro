---
const diagram = `flowchart TD
    household[Household members]
    app[Expo / React Native app]
    api[Hono API<br/>Authentication, roles and permissions]
    db[(PostgreSQL<br/>Control plane and outbox)]
    graph[LangGraph<br/>Workflow state and pause / resume]
    memory[(Mem0<br/>Household and member memory)]
    model[LLM through LangChain<br/>Chooses the next safe step]
    mcp[Silpo MCP tools<br/>Products, basket and fulfillment]
    silpo[Silpo<br/>Provider source of truth and checkout]

    household -->|Requests and approvals| app
    app -->|Commands and status| api
    api <-->|Users, roles and workflow references| db
    api -->|Authorized event| graph
    graph <-->|Read and update long-term context| memory
    graph <-->|Reason about the next step| model
    graph -->|Execute provider action| mcp
    mcp <-->|Current catalog and basket| silpo
    mcp -->|Tool result| graph
    graph -->|Updated workflow status| api
    api --> app`;
---

<div class="miyko-architecture" role="img" aria-label="MiyKo application architecture flowchart">
  <pre class="mermaid">{diagram}</pre>
</div>

<script>
  const renderMermaid = async (node: HTMLElement) => {
    const { default: mermaid } = await import("mermaid");

    mermaid.initialize({
      startOnLoad: false,
      securityLevel: "strict",
      theme: "base",
      themeVariables: {
        background: "transparent",
        primaryColor: "#ffffff",
        primaryTextColor: "#000000",
        primaryBorderColor: "#000000",
        lineColor: "#000000",
        secondaryColor: "#ffffff",
        tertiaryColor: "#ffffff",
      },
    });

    await mermaid.run({ nodes: [node] });
  };

  const renderPageDiagrams = () => {
    const nodes = document.querySelectorAll<HTMLElement>(
      ".mermaid:not([data-processed='true'])",
    );

    for (const node of nodes) {
      void renderMermaid(node);
    }
  };

  renderPageDiagrams();
  document.addEventListener("astro:page-load", renderPageDiagrams);
</script>

<style>
  .miyko-architecture {
    margin-block: 2rem;
    overflow-x: auto;
  }

  .miyko-architecture :global(.mermaid) {
    display: flex;
    min-width: 42rem;
    justify-content: center;
    background: transparent;
  }

  .miyko-architecture :global(svg) {
    max-width: 100%;
    height: auto;
  }
</style>

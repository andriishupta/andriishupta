---
const diagram = `flowchart TD
    members["Group members"]
    mobile["Expo / React Native app"]
    api["Hono API: identity and permissions"]
    database[("PostgreSQL: roles, references and outbox")]
    workflow["LangGraph: order state and pause / resume"]
    memory[("Mem0: long-term group and member memory")]
    llm["LLM through LangChain"]
    tools["Silpo MCP tools"]
    provider["Silpo: products, basket and checkout"]

    members -->|Requests and approvals| mobile
    mobile <-->|Commands and status| api
    api <-->|Control data| database
    api -->|Authorized event| workflow
    workflow <-->|Relevant memory| memory
    workflow <-->|Next step| llm
    workflow <-->|Provider action and result| tools
    tools <-->|Current products and basket| provider
    workflow -->|Updated status| api`;
---

<div class="miyko-architecture" role="img" aria-label="MiyKo architecture: group members, mobile app, API, LangGraph workflow, Mem0 memory, language model, and Silpo provider">
  <pre class="mermaid">{diagram}</pre>
</div>

<script>
  const renderPageDiagrams = async () => {
    const nodes = document.querySelectorAll<HTMLElement>(
      ".miyko-architecture .mermaid:not([data-processed='true'])",
    );

    if (nodes.length === 0) return;

    const { default: mermaid } = await import("mermaid");
    mermaid.initialize({
      startOnLoad: false,
      securityLevel: "strict",
      theme: "base",
      themeVariables: {
        background: "#ffffff",
        primaryColor: "#ffffff",
        primaryTextColor: "#000000",
        primaryBorderColor: "#000000",
        lineColor: "#000000",
        secondaryColor: "#ffffff",
        tertiaryColor: "#ffffff",
      },
      flowchart: { htmlLabels: false },
    });

    await mermaid.run({ nodes });
  };

  void renderPageDiagrams();
  document.addEventListener("astro:page-load", () => void renderPageDiagrams());
</script>

<style>
  .miyko-architecture {
    margin-block: 2rem;
    padding: 1.5rem;
    overflow-x: auto;
    background: #fff;
    color: #000;
    border: 1px solid #d8d8d8;
  }

  .miyko-architecture :global(.mermaid) {
    display: flex;
    min-width: 42rem;
    justify-content: center;
    margin: 0;
    background: #fff;
    color: #000;
  }

  .miyko-architecture :global(svg) {
    max-width: 100%;
    height: auto;
  }
</style>

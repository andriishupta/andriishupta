---
import About from "../components/About.astro";
import Approach from "../components/Approach.astro";
import Experience from "../components/Experience.astro";
import Hero from "../components/Hero.astro";
import Proof from "../components/Proof.astro";
import SiteFooter from "../components/SiteFooter.astro";
import UseCases from "../components/UseCases.astro";
import { copy, identityProfileLinks } from "../copy";
import Layout from "../layouts/Layout.astro";
import "../styles/home.css";

const siteUrl = "https://andriishupta.dev";
const { seo } = copy;
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      url: siteUrl,
      name: copy.identity.fullName,
      description: seo.description,
      inLanguage: "en",
    },
    {
      "@type": "ProfilePage",
      "@id": `${siteUrl}/#profile`,
      url: siteUrl,
      name: seo.title,
      description: seo.description,
      isPartOf: { "@id": `${siteUrl}/#website` },
      mainEntity: { "@id": `${siteUrl}/#person` },
      inLanguage: "en",
    },
    {
      "@type": "Person",
      "@id": `${siteUrl}/#person`,
      name: copy.identity.fullName,
      url: siteUrl,
      image: `${siteUrl}/og-image.png`,
      jobTitle: "Software Consultant",
      description: seo.description,
      email: copy.identity.email,
      sameAs: identityProfileLinks.map(({ href }) => href),
      knowsAbout: seo.knowsAbout,
    },
  ],
};
---

<Layout
    title={seo.title}
    description={seo.description}
    pathname="/"
    image="/og-image.png"
    imageAlt={seo.imageAlt}
    ogType="profile"
    structuredData={structuredData}
    showThemeSwitcher={false}
>
    <main>
        <Hero />
        <About />
        <Approach />
        <Proof />
        <UseCases />
        <Experience />
    </main>
    <SiteFooter context="home" />
</Layout>

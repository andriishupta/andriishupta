---
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import PortfolioCard from "../../components/PortfolioCard.astro";
import { getPortfolioItems, getPortfolioPath } from "../../lib/portfolio";
import { copy } from "../../copy";
import Layout from "../../layouts/Layout.astro";
import "../../styles/portfolio.css";

const pageCopy = copy.pages.portfolio;
const title = `${pageCopy.title} | ${copy.identity.fullName}`;
const description = pageCopy.description;
const pageUrl = new URL(pageCopy.path, "https://andriishupta.dev").toString();
const portfolioItems = await getPortfolioItems({ featuredFirst: true });
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": `${pageUrl}/#portfolio`,
      name: title,
      description,
      url: pageUrl,
      isPartOf: { "@id": "https://andriishupta.dev/#website" },
      mainEntity: { "@id": `${pageUrl}/#case-studies` },
    },
    {
      "@type": "ItemList",
      "@id": `${pageUrl}/#case-studies`,
      itemListElement: portfolioItems.map((item, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: item.data.title,
        description: item.data.subtitle,
        url: new URL(
          getPortfolioPath(item),
          "https://andriishupta.dev",
        ).toString(),
      })),
    },
  ],
};
---

<Layout
  title={title}
  description={description}
  pathname={pageCopy.path}
  image="/portfolio/og.png"
  imageAlt={pageCopy.imageAlt}
  structuredData={structuredData}
  showThemeSwitcher={false}
>
  <SiteHeader context="portfolio" />

  <main class="portfolio-index">
    <header class="portfolio-index__intro content-container">
      <h1 class="heading-display">{pageCopy.heading} by {copy.identity.fullName}</h1>
      <p>{pageCopy.intro}</p>
    </header>

    <section
      class="portfolio-grid content-container"
      aria-label="Case studies"
      data-reveal-group
    >
      {portfolioItems.map((item, index) => (
        <PortfolioCard item={item} revealOrder={Math.min(index, 3)} />
      ))}
    </section>
  </main>

  <SiteFooter />
</Layout>

<script>
  import { revealOnce } from "../../lib/reveal";

  revealOnce();
</script>

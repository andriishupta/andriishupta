---
import { getBlogStaticPaths, type BlogPostPageProps } from "../../../lib/blog";
import BlogPostLayout from "../../../layouts/BlogPostLayout.astro";

type Props = BlogPostPageProps;

export async function getStaticPaths() {
  return getBlogStaticPaths("uk");
}

const { post, newerPost, olderPost, alternatePost } = Astro.props;
---

<BlogPostLayout
  post={post}
  newerPost={newerPost}
  olderPost={olderPost}
  alternatePost={alternatePost}
/>

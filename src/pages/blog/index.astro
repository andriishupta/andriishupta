---
import ArrowRight from "@lucide/astro/icons/arrow-right";
import LayoutGrid from "@lucide/astro/icons/layout-grid";
import ListIcon from "@lucide/astro/icons/list";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import { copy } from "../../copy";
import {
  blogTopicDefinitions,
  formatBlogDate,
  getBlogPosts,
  getBlogTopicSlug,
  getPostPath,
  getReadingStats,
  hasMeaningfulUpdate,
  toIsoDate,
} from "../../lib/blog";
import Layout from "../../layouts/Layout.astro";
import "../../styles/blog.css";

const posts = await getBlogPosts();
const topicCounts = new Map<string, number>();

for (const post of posts) {
  for (const topic of post.data.topics) {
    topicCounts.set(topic, (topicCounts.get(topic) ?? 0) + 1);
  }
}

const topicFilters = blogTopicDefinitions
  .map(({ label, slug }) => [label, slug, topicCounts.get(label) ?? 0] as const)
  .filter(([, , count]) => count > 0);
const title = `Software Engineering Blog | ${copy.identity.fullName}`;
const description =
  "Blog posts by Andrii Shupta on software architecture, web development, integrations, security, and production engineering.";
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Blog",
      "@id": "https://andriishupta.dev/blog/#blog",
      url: "https://andriishupta.dev/blog",
      name: `${copy.identity.fullName} — Blog`,
      description,
      inLanguage: "en",
      author: { "@id": "https://andriishupta.dev/#person" },
      blogPost: posts.map((post) => ({
        "@type": "BlogPosting",
        headline: post.data.title,
        url: new URL(getPostPath(post), "https://andriishupta.dev").toString(),
        datePublished: toIsoDate(post.data.publishedAt),
        dateModified: toIsoDate(post.data.updatedAt ?? post.data.publishedAt),
      })),
    },
    {
      "@type": "CollectionPage",
      url: "https://andriishupta.dev/blog",
      name: title,
      isPartOf: { "@id": "https://andriishupta.dev/#website" },
      mainEntity: { "@id": "https://andriishupta.dev/blog/#blog" },
    },
  ],
};
---

<Layout
  title={title}
  description={description}
  pathname="/blog"
  image="/blog/og.png"
  imageAlt="Andrii Shupta — technical writing on software and systems"
  structuredData={structuredData}
  showThemeSwitcher={false}
  rss
>
  <script is:inline>
    if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      document.documentElement.dataset.blogIntro = "true";
    }
  </script>
  <SiteHeader context="blog" />

  <main class="blog-index">
    <header class="blog-index__intro content-container">
      <h1 class="heading-display">
        Software Engineering Blog by {copy.identity.fullName}
      </h1>
      <p>Articles on software, systems, and the work behind them.</p>
    </header>

    <section
      class="blog-controls content-container"
      aria-label="Browse articles"
      data-blog-controls
    >
      <div class="blog-controls__topics">
        <p>Topics</p>
        <div class="blog-topic-filters" role="group" aria-label="Filter by topic">
          <button
            type="button"
            data-blog-filter="all"
            aria-pressed="true"
            aria-controls="blog-archive"
          >
            <span>All</span>
            <small>{posts.length}</small>
          </button>
          {
            topicFilters.map(([topic, slug, count]) => (
              <button
                type="button"
                data-blog-filter={slug}
                data-count={count}
                aria-pressed="false"
                aria-controls="blog-archive"
              >
                <span>{topic}</span>
                <small>{count}</small>
              </button>
            ))
          }
        </div>
      </div>

      <div class="blog-view-switcher" role="group" aria-label="Article layout">
        <button
          type="button"
          data-blog-view="list"
          aria-label="Show articles as a list"
          aria-pressed="true"
          title="List view"
        >
          <ListIcon aria-hidden="true" />
        </button>
        <button
          type="button"
          data-blog-view="grid"
          aria-label="Show articles as a grid"
          aria-pressed="false"
          title="Grid view"
        >
          <LayoutGrid aria-hidden="true" />
        </button>
      </div>
    </section>

    <p
      class="blog-results content-container sr-only"
      aria-live="polite"
      data-blog-results
    >
      {posts.length} articles
    </p>

    <p class="blog-empty content-container" data-blog-empty hidden>
      No published posts in this topic yet.
    </p>

    <section
      class="blog-archive content-container"
      id="blog-archive"
      aria-label="Articles"
      data-blog-archive
      data-view="list"
    >
      {
        posts.map((post) => {
          const stats = getReadingStats(
            post.body,
            post.data.originalReadingMinutes,
          );
          const image = post.data.ogImage ?? "/blog/og.png";

          return (
            <article
              class="blog-entry"
              data-blog-entry
              data-topics={post.data.topics.map(getBlogTopicSlug).join(",")}
            >
              <a class="blog-entry__link" href={getPostPath(post)}>
                <div class="blog-entry__content">
                  <div class="blog-entry__meta">
                    <time datetime={toIsoDate(post.data.publishedAt)}>
                      {formatBlogDate(post.data.publishedAt)}
                    </time>
                    {stats.readingMinutes > 0 && (
                      <span>
                        {stats.readingMinutes} min {stats.isStub ? "original " : ""}read
                      </span>
                    )}
                    {hasMeaningfulUpdate(post) && post.data.updatedAt && (
                      <span>
                        Updated {formatBlogDate(post.data.updatedAt)}
                      </span>
                    )}
                  </div>

                  {stats.isStub && (
                    <span class="blog-entry__status">Import pending</span>
                  )}

                  <h2>{post.data.title}</h2>
                  {(post.data.subtitle || post.data.description) && (
                    <p>{post.data.subtitle ?? post.data.description}</p>
                  )}

                  <div class="blog-entry__footer">
                    <ul class="blog-entry__tags" aria-label="Tags">
                      {post.data.tags.map((tag) => (
                        <li>#{tag}</li>
                      ))}
                    </ul>
                    <span class="blog-entry__read">
                      <span class="blog-entry__read-label">Read article</span>
                      <ArrowRight aria-hidden="true" />
                    </span>
                  </div>
                </div>

                <figure class="blog-entry__image">
                  <img
                    src={image}
                    alt=""
                    width="1200"
                    height="630"
                    loading="lazy"
                    decoding="async"
                  />
                </figure>
              </a>
            </article>
          );
        })
      }
    </section>
  </main>

  <SiteFooter />
</Layout>

<script>
  import { gsap } from "gsap";

  type BlogView = "list" | "grid";

  const archive = document.querySelector<HTMLElement>("[data-blog-archive]");
  const entries = Array.from(
    document.querySelectorAll<HTMLElement>("[data-blog-entry]"),
  );
  const filterButtons = Array.from(
    document.querySelectorAll<HTMLButtonElement>("[data-blog-filter]"),
  );
  const viewButtons = Array.from(
    document.querySelectorAll<HTMLButtonElement>("[data-blog-view]"),
  );
  const results = document.querySelector<HTMLElement>("[data-blog-results]");
  const emptyState = document.querySelector<HTMLElement>("[data-blog-empty]");
  const viewStorageKey = "andrii-blog-view";
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  const isBlogView = (value: string | null): value is BlogView =>
    value === "list" || value === "grid";

  const getVisibleEntries = () => entries.filter((entry) => !entry.hidden);

  const animateEntries = () => {
    if (reduceMotion) return;
    const visibleEntries = getVisibleEntries();
    gsap.killTweensOf(visibleEntries);
    gsap.fromTo(
      visibleEntries,
      { autoAlpha: 0, y: 12 },
      {
        autoAlpha: 1,
        y: 0,
        duration: 0.4,
        stagger: 0.05,
        ease: "power2.out",
        clearProps: "opacity,transform,visibility",
      },
    );
  };

  const setView = (view: BlogView, persist = true, animate = true) => {
    if (!archive) return;

    archive.dataset.view = view;
    viewButtons.forEach((button) => {
      button.setAttribute(
        "aria-pressed",
        String(button.dataset.blogView === view),
      );
    });

    if (persist) {
      try {
        window.localStorage.setItem(viewStorageKey, view);
      } catch {
        // The view still changes when storage is unavailable.
      }
    }

    if (animate) animateEntries();
  };

  const setFilter = (topic: string, animate = true) => {
    let visibleCount = 0;

    entries.forEach((entry) => {
      const entryTopics = (entry.dataset.topics ?? "").split(",");
      const matches = topic === "all" || entryTopics.includes(topic);
      entry.hidden = !matches;
      if (matches) visibleCount += 1;
    });

    filterButtons.forEach((button) => {
      button.setAttribute(
        "aria-pressed",
        String(button.dataset.blogFilter === topic),
      );
    });

    if (results) {
      results.textContent =
        visibleCount === 1 ? "1 article" : `${visibleCount} articles`;
    }
    if (emptyState) emptyState.hidden = visibleCount !== 0;

    const url = new URL(window.location.href);
    if (topic === "all") {
      url.searchParams.delete("topic");
    } else {
      url.searchParams.set("topic", topic);
    }
    window.history.replaceState({}, "", `${url.pathname}${url.search}${url.hash}`);
    if (animate) animateEntries();
  };

  viewButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const view = button.dataset.blogView;
      if (isBlogView(view ?? null)) setView(view);
    });
  });

  filterButtons.forEach((button) => {
    button.addEventListener("click", () => {
      setFilter(button.dataset.blogFilter ?? "all");
    });
  });

  try {
    const storedView = window.localStorage.getItem(viewStorageKey);
    if (isBlogView(storedView)) setView(storedView, false, false);
  } catch {
    // List view remains the safe default.
  }

  const requestedTopic = new URLSearchParams(window.location.search).get("topic");
  const availableTopic = filterButtons.some(
    (button) => button.dataset.blogFilter === requestedTopic,
  );
  if (requestedTopic && !availableTopic) {
    const url = new URL(window.location.href);
    url.searchParams.delete("topic");
    window.history.replaceState({}, "", `${url.pathname}${url.search}${url.hash}`);
  }
  setFilter(availableTopic && requestedTopic ? requestedTopic : "all", false);

  const introItems = [
    document.querySelector(".blog-index__intro"),
    document.querySelector("[data-blog-controls]"),
    document.querySelector("[data-blog-results]"),
  ].filter((item): item is Element => item instanceof Element);

  if (reduceMotion) {
    delete document.documentElement.dataset.blogIntro;
  } else {
    gsap.timeline({
      defaults: { ease: "power3.out" },
      onComplete: () => {
        delete document.documentElement.dataset.blogIntro;
        gsap.set([...introItems, ...getVisibleEntries()], {
          clearProps: "opacity,transform,visibility",
        });
      },
    })
      .fromTo(
        introItems,
        { autoAlpha: 0, y: 16 },
        {
          autoAlpha: 1,
          y: 0,
          duration: 0.52,
          stagger: 0.08,
        },
      )
      .fromTo(
        getVisibleEntries(),
        { autoAlpha: 0, y: 16 },
        {
          autoAlpha: 1,
          y: 0,
          duration: 0.48,
          stagger: 0.06,
        },
        "-=0.24",
      );
  }
</script>
